{
  "title": "设备维修工单：从报障到关闭",
  "scope": "三责任分区的活动图；明确对象流、排他判断、并发同步、返修回路和两类终点",
  "assumptions": [
    "教学数据与流程为模拟，不代表现场制度",
    "泳道表示责任分区，不改变令牌流语义",
    "FlowFinal只结束退回分支，ActivityFinal结束整个活动"
  ],
  "partitions": [
    {"id": "requester", "name": "报障人员", "order": 0},
    {"id": "coordinator", "name": "维修协调", "order": 1},
    {"id": "field", "name": "现场维修", "order": 2}
  ],
  "nodes": [
    {"id": "start", "name": "开始", "kind": "initial", "partition": "requester", "row": 0},
    {"id": "submit", "name": "提交报障", "kind": "action", "partition": "requester", "row": 1},
    {"id": "incident", "name": "报障信息", "kind": "object", "partition": "coordinator", "row": 2},
    {"id": "validate", "name": "核对信息", "kind": "action", "partition": "coordinator", "row": 3},
    {"id": "complete", "name": "信息完整？", "kind": "decision", "partition": "coordinator", "row": 4},
    {"id": "return", "name": "退回补充", "kind": "action", "partition": "requester", "row": 5},
    {"id": "create", "name": "创建工单", "kind": "action", "partition": "coordinator", "row": 5},
    {"id": "return_end", "name": "退回流终点", "kind": "flow_final", "partition": "requester", "row": 6},
    {"id": "work_order", "name": "维修工单", "kind": "object", "partition": "field", "row": 6},
    {"id": "parallel", "name": "并行分派", "kind": "fork", "partition": "coordinator", "row": 7},
    {"id": "dispatch", "name": "调度资源", "kind": "action", "partition": "coordinator", "row": 8},
    {"id": "inspect", "name": "现场诊断", "kind": "action", "partition": "field", "row": 8},
    {"id": "ready", "name": "准备完成", "kind": "join", "partition": "coordinator", "row": 9},
    {"id": "repair_entry", "name": "返修合并", "kind": "merge", "partition": "field", "row": 10},
    {"id": "repair", "name": "执行维修", "kind": "action", "partition": "field", "row": 11},
    {"id": "test", "name": "功能验证", "kind": "action", "partition": "field", "row": 12},
    {"id": "passed", "name": "验证通过？", "kind": "decision", "partition": "field", "row": 13},
    {"id": "close", "name": "关闭工单", "kind": "action", "partition": "coordinator", "row": 14},
    {"id": "done", "name": "活动终点", "kind": "activity_final", "partition": "coordinator", "row": 15}
  ],
  "edges": [
    {"id": "e01", "kind": "control", "source": "start", "target": "submit"},
    {"id": "e02", "kind": "object", "source": "submit", "target": "incident", "label": "报障信息"},
    {"id": "e03", "kind": "object", "source": "incident", "target": "validate"},
    {"id": "e04", "kind": "control", "source": "validate", "target": "complete"},
    {"id": "e05", "kind": "control", "source": "complete", "target": "return", "guard": "缺项"},
    {"id": "e06", "kind": "control", "source": "return", "target": "return_end"},
    {"id": "e07", "kind": "control", "source": "complete", "target": "create", "guard": "完整"},
    {"id": "e08", "kind": "object", "source": "create", "target": "work_order", "label": "维修工单"},
    {"id": "e09", "kind": "control", "source": "create", "target": "parallel"},
    {"id": "e10", "kind": "control", "source": "parallel", "target": "dispatch"},
    {"id": "e11", "kind": "control", "source": "parallel", "target": "inspect"},
    {"id": "e12", "kind": "object", "source": "work_order", "target": "inspect"},
    {"id": "e13", "kind": "control", "source": "dispatch", "target": "ready"},
    {"id": "e14", "kind": "control", "source": "inspect", "target": "ready"},
    {"id": "e15", "kind": "control", "source": "ready", "target": "repair_entry"},
    {"id": "e16", "kind": "control", "source": "repair_entry", "target": "repair"},
    {"id": "e17", "kind": "control", "source": "repair", "target": "test"},
    {"id": "e18", "kind": "control", "source": "test", "target": "passed"},
    {"id": "e19", "kind": "control", "source": "passed", "target": "repair_entry", "guard": "未通过"},
    {"id": "e20", "kind": "control", "source": "passed", "target": "close", "guard": "通过"},
    {"id": "e21", "kind": "control", "source": "close", "target": "done"}
  ]
}
