    }
  ],
  "worker_nodes": [
    {
      "id": "node-a",
      "cluster_id": "cluster-prod",
      "label": "Worker A",
      "kubelet": "enabled",
      "container_runtime": "containerd",
      "position": [
        0.2,
        0.11
      ]
    },
    {
      "id": "node-b",
      "cluster_id": "cluster-prod",
      "label": "Worker B",
      "kubelet": "enabled",
      "container_runtime": "containerd",
      "position": [
        0.8,
        0.11
      ]
    }
  ],
  "workloads": [
    {
      "id": "api-deploy",
      "label": "维护 API",
      "kind": "Deployment",
      "namespace_id": "ns-maint",
      "replicas": 3,
      "pod_labels": {
        "app": "maintenance-api"
      },
      "image": "registry.example/maintenance-api:simulated",
      "position": [
        0.48,
        0.43
      ]
    },
    {
      "id": "worker-stateful",
      "label": "事件处理器",
      "kind": "StatefulSet",
      "namespace_id": "ns-maint",
      "replicas": 2,
      "pod_labels": {
        "app": "event-worker"
      },
      "image": "registry.example/event-worker:simulated",
      "position": [
        0.72,
        0.43
      ]
    }
  ],
  "services": [
    {
      "id": "api-service",
      "label": "maintenance-api",
      "namespace_id": "ns-maint",
      "selector": {
        "app": "maintenance-api"
      },
      "ports": [
        {
          "port": 443,
          "target_port": 8443,
          "protocol": "TCP"
        }
      ],
      "position": [
        0.28,
        0.5
      ]
    },
    {
      "id": "worker-service",
      "label": "event-worker",
      "namespace_id": "ns-maint",
      "selector": {
        "app": "event-worker"
      },
      "ports": [
        {
          "port": 9090,
          "target_port": 9090,
          "protocol": "TCP"
        }
      ],
      "position": [
        0.72,
        0.58
      ]
    }
  ],
  "ingresses": [
    {
      "id": "ingress",
      "label": "维护入口",
      "namespace_id": "ns-maint",
      "host": "maintenance.example.invalid",
      "routes": [
        {
          "path": "/api",
          "service_id": "api-service",
          "port": 443
        }
      ],
      "position": [
        0.1,
        0.5
      ]
    }
  ],
  "configuration": [
    {
      "id": "config",
      "label": "应用配置",
      "kind": "ConfigMap",
      "namespace_id": "ns-maint",
      "consumer_workload_ids": [
        "api-deploy",
        "worker-stateful"
      ],
      "position": [
        0.4,
        0.22
      ]
    },
    {
      "id": "secret",
      "label": "数据库凭据",
      "kind": "Secret",
      "namespace_id": "ns-maint",
      "consumer_workload_ids": [
        "api-deploy"
      ],
      "values_redacted": true,
      "position": [
        0.6,
        0.22
      ]
    }
  ],
  "persistent_volume_claims": [
    {
      "id": "pvc",
      "label": "事件检查点",
      "namespace_id": "ns-maint",
      "storage_class": "standard-rwo",
      "size_gib": 20,
      "consumer_workload_ids": [
        "worker-stateful"
      ],
      "position": [
        0.82,
        0.25
      ]
    }
  ]
}
