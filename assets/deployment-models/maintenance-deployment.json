  "devices": [
    {"id": "tablet", "name": "维修平板", "instance": "tablet-01", "type": "MaintenanceTablet", "column": 0, "row": 0},
    {"id": "edge", "name": "产线边缘网关", "instance": "edge-01", "type": "EdgeGateway", "column": 1, "row": 0},
    {"id": "app", "name": "应用主机", "instance": "app-01", "type": "LinuxHost", "column": 2, "row": 0},
    {"id": "db", "name": "数据库主机", "instance": "db-01", "type": "LinuxHost", "column": 3, "row": 0}
  ],
  "environments": [
    {"id": "android", "name": "移动运行环境", "instance": "android-runtime", "type": "AndroidRuntime", "device": "tablet", "order": 0},
    {"id": "edge_runtime", "name": "边缘执行环境", "instance": "edge-runtime", "type": "ContainerRuntime", "device": "edge", "order": 0},
    {"id": "jvm", "name": "应用执行环境", "instance": "jvm-runtime", "type": "JVM", "device": "app", "order": 0},
