  ],
  "artifacts": [
    {"id": "field_client", "name": "field-client.apk", "target": "android", "order": 0, "kind": "executable"},
    {"id": "edge_agent", "name": "edge-agent.jar", "target": "edge_runtime", "order": 0, "kind": "executable"},
    {"id": "maintenance_api", "name": "maintenance-api.jar", "target": "jvm", "order": 0, "kind": "executable"},
    {"id": "report_worker", "name": "report-worker.jar", "target": "jvm", "order": 1, "kind": "executable"},
    {"id": "maintenance_schema", "name": "maintenance-schema.sql", "target": "postgres", "order": 0, "kind": "source"}
