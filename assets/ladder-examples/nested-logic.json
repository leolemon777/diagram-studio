      "role": "input",
      "source": "假设教学信号，不对应现场地址"
    },
    {
      "id": "Manual",
      "label": "手动模式",
      "role": "input",
      "source": "假设教学信号，不对应现场地址"
    },
    {
      "id": "Jog",
      "label": "点动请求",
      "role": "input",
      "source": "假设教学信号，不对应现场地址"
    },
    {
      "id": "Ready",
      "label": "设备就绪",
      "role": "input",
      "source": "假设教学信号，不对应现场地址"
