{
  "id": "alarm-cleaning-program", "mode": "program",
  "title": "报警记录清洗程序流程", "subtitle": "循环变量、分支条件与退出路径完整", "data_status": "simulated",
  "nodes": [
    {"id": "start", "type": "start", "label": "开始"},
    {"id": "input", "type": "input", "label": "读取报警记录 records"},
    {"id": "init", "type": "process", "label": "初始化 i = 0，clean = []"},
    {"id": "more", "type": "decision", "label": "仍有记录？", "condition": "i < len(records)"},
    {"id": "valid", "type": "decision", "label": "字段有效？", "condition": "tag 非空且 timestamp 可解析"},
    {"id": "append", "type": "process", "label": "追加规范化记录"},
    {"id": "reject", "type": "process", "label": "记录拒绝原因"},
    {"id": "increment", "type": "process", "label": "i = i + 1"},
    {"id": "output", "type": "output", "label": "输出 clean 与 reject_log"},
    {"id": "end", "type": "end", "label": "结束"}
  ],
  "edges": [
    {"source": "start", "target": "input"}, {"source": "input", "target": "init"}, {"source": "init", "target": "more"},
    {"source": "more", "target": "valid", "label": "是"}, {"source": "more", "target": "output", "label": "否"},
    {"source": "valid", "target": "append", "label": "是"}, {"source": "valid", "target": "reject", "label": "否"},
    {"source": "append", "target": "increment"}, {"source": "reject", "target": "increment"},
    {"source": "increment", "target": "more", "label": "下一条", "loop": true}, {"source": "output", "target": "end"}
  ],
  "assumptions": ["算法为演示伪流程", "字段有效性必须在实际实现中细化并测试"]
}
