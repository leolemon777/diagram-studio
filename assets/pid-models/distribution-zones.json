        {
          "id": "tap_out",
          "domain": "process",
          "direction": "out"
        },
        {
          "id": "tap_sense",
          "domain": "process",
          "direction": "bidirectional"
        }
      ]
    },
    {
      "id": "header",
      "tag": "J-801",
      "kind": "junction",
      "label": "配送分支点",
      "ports": [
        {
          "id": "header_in",
          "domain": "process",
          "direction": "in"
        },
        {
          "id": "header_a",
          "domain": "process",
          "direction": "out"
        },
        {
          "id": "header_b",
          "domain": "process",
          "direction": "out"
        }
      ]
    },
    {
      "id": "valve_a",
      "tag": "HV-801",
