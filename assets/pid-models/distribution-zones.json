    {
      "id": "valve_b",
      "tag": "HV-802",
      "kind": "valve",
      "label": "B区分区阀",
      "ports": [
        {
          "id": "valve_b_in",
          "domain": "process",
          "direction": "in"
        },
        {
          "id": "valve_b_out",
          "domain": "process",
          "direction": "out"
        }
      ]
    },
    {
      "id": "zone_b",
      "tag": "B-802",
