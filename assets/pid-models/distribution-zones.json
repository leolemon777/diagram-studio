{
  "schema": "pid-topology-1",
  "title": "供水母管与分区阀：配送 P&ID 教学拓扑",
  "assumptions": [
    "模拟供水槽经泵和母管分配至两个区域；连接存在不代表支路阀门开启。",
    "不编造管径、标高、压力等级、泵曲线、水力平衡或终端需求。",
    "独立教学符号未验证为完整 ISA 5.1 符号集，也不是 DEXPI 交换文件。"
  ],
  "items": [
    {
      "id": "tank",
      "tag": "TK-801",
      "kind": "tank",
      "label": "供水槽",
      "ports": [
        {
          "id": "tank_out",
          "domain": "process",
          "direction": "out"
        }
      ]
    },
    {
      "id": "pump",
      "tag": "P-801",
      "kind": "pump",
      "label": "配送泵",
      "ports": [
        {
          "id": "pump_in",
          "domain": "process",
          "direction": "in"
        },
        {
          "id": "pump_out",
          "domain": "process",
          "direction": "out"
        }
      ]
    },
    {
