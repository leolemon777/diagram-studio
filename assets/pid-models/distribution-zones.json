      "domain": "process",
      "label": "B区支路",
      "flow": "forward"
    },
    {
      "id": "C7",
      "from": "valve_b_out",
      "to": "zone_b_in",
      "domain": "process",
      "label": "B区供水",
      "flow": "forward"
    },
    {
      "id": "C8",
      "from": "tap_sense",
