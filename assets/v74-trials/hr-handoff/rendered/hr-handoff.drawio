<mxfile host="diagram-studio" version="1.0"><diagram id="diagram" name="服务请求 · 责任交接"><mxGraphModel dx="1600" dy="1060" grid="1" gridSize="8" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#F1EFEB"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane1" value="01  申请人" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="204" width="1472" height="162" /></mxCell><mxCell id="lane2" value="02  协调团队" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="402" width="1472" height="250" /></mxCell><mxCell id="lane3" value="03  执行团队" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="700" width="1472" height="190" /></mxCell><mxCell id="submit" value="&lt;b&gt;提交请求&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;说明目标与约束&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="125" y="265" width="240" height="68" /></mxCell><mxCell id="clarify" value="&lt;b&gt;补充信息&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;回答关键问题&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="265" width="240" height="68" /></mxCell><mxCell id="triage" value="&lt;b&gt;确认范围&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;明确优先级与交付物&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="460" width="240" height="84" /></mxCell><mxCell id="check" value="信息完整？" style="shape=rhombus;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="775" y="433" width="232" height="132" /></mxCell><mxCell id="deliver" value="&lt;b&gt;执行交付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;提交可验收成果与复盘记录&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="760" width="246" height="84" /></mxCell><mxCell id="review" value="&lt;b&gt;验收反馈&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;协调团队确认质量&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#67685E;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="460" width="246" height="84" /></mxCell><mxCell id="