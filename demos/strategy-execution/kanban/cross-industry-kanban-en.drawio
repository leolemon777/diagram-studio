 y="891" width="730" height="62" as="geometry" /></mxCell><mxCell id="policy-done" value="&lt;b&gt;Done&lt;/b&gt;　Evidence, acceptance check and release note are complete before an item enters Done." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#CFC7BA;fillColor=#FBFAF7;fontColor=#30302D;fontSize=11;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="805" y="891" width="730" height="62" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
