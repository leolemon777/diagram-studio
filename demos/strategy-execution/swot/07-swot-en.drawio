<mxfile host="diagram-studio" version="1.0"><diagram id="diagram" name="Community learning platform · SWOT scan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F1EFEB"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_v1" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="64.0" y="198" width="724.0" height="235" /></mxCell><mxCell id="_v2" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#AC6046;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64.0" y="198" width="5" height="235" /></mxCell><mxCell id="_v3" value="S  Strengths" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=PingFang SC;fontSize=24;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="92.0" y="222" width="668.0" height="36" /></mxCell><mxCell id="_v4" value="•  Peer mentors already share practical examples" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="94.0" y="281" width="664.0" height="30" /></mxCell><mxCell id="_v5" value="•  Short lessons fit existing study routines" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="94.0" y="313" width="664.0" height="30" /></mxCell><mxCell id="_v6" value="•  Pilot groups can test changes in stages" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="94.0" y="345" width="664.0" height="30" /></mxCell><mxCell id="_v7" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="812.0" y="198" width="724.0" height="235" /></mxCell><mxCell id="_v8" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C7964;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="812.0" y="198" width="5" height="235" /></mxCell><mxCell id="_v9" value="W  Weaknesses" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#8C7964;fontFamily=PingFang SC;fontSize=24;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="840.0" y="222" width="668.0" height="36" /></mxCell><mxCell id="_v10" value="•  Learner goals are not yet consistently captured" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="842.0" y="281" width="664.0" height="30" /></mxCell><mxCell id="_v11" value="•  Content quality needs a review path" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontCo