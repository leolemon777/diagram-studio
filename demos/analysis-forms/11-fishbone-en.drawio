<mxfile host="diagram-studio" version="1.0"><diagram id="diagram" name="Service requests repeatedly incomplete · cause hypotheses"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F1EFEB"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_v1" value="&lt;b&gt;Service requests repeatedly incomplete&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#6D6A63&quot;&gt;Confirm frequency, contexts and the completion definition&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#AC6046;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1282" y="391.05" width="240" height="177.9" /></mxCell><mxCell id="_v2" value="People" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=PingFang SC;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="100.0" y="236" width="260" height="36" /></mxCell><mxCell id="_v3" value="• Handover information may be incomplete" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.0" y="300" width="250" height="46" /></mxCell><mxCell id="_v4" value="• Training and authorisation may not match" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.0" y="354" width="250" height="46" /></mxCell><mxCell id="_v5" value="Process" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=PingFang SC;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="100.0" y="628" width="260" height="36" /></mxCell><mxCell id="_v6" value="• The handling path may be unclear" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.0" y="510" width="250" height="46" /></mxCell><mxCell id="_v7" value="• Exception returns may have no owner" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75.0" y="564" width="250" height="46" /></mxCell><mxCell id="_v8" value="Tools" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#67685E;fontFamily=PingFang SC;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="473.33333333333326" y="236" width="260" height="36" /></mxCell><mxCell id="_v9" value="• System state may be unstable" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="448.33333333333326" y="300" width="250" height="32" /></mxCell><mxCell id="_v10" value="• Required data fields may be missing" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=PingFang SC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="448.33333333333326" y="340" width="250" height="46" /></mxCell><mxCell