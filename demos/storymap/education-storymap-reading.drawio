:17px;color:#6D6A63;font-weight:400&quot;&gt;补充信任信息与异常&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#6D6A63;font-weight:400&quot;&gt;恢复，使首次使&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#6D6A63;font-weight:400&quot;&gt;用更安心。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="82" y="748" width="176" height="73" /></mxCell><mxCell id="story-S04" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="282.0" y="667" width="368.6666666666667" height="187" /></mxCell><mxCell id="storytext-S04-0" value="&lt;span style=&quot;font-size:14px;color:#AC6046;font-weight:400&quot;&gt;S04&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="298.0" y="683" width="336.6666666666667" height="23" /></mxCell><mxCell id="storytext-S04-1" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;预览学习方式&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=20;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="298.0" y="713" width="336.6666666666667" height="31" /></mxCell><mxCell id="storytext-S04-2" value="&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;展示一段有字幕的课程预览，说明&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;练习与答疑安排。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="298.0" y="751" width="336.6666666666667" height="50" /></mxCell><mxCell id="storytext-S04-3" value="&lt;span style=&quot;font-size:14px;color:#6D6A63;font-weight:400&quot;&gt;来源：模拟反馈 E06&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="298.0" y="808" width="336.6666666666667" height="23" /></mxCell><mxCell id="story-S05" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="666.6666666666667" y="667" width="368.6666666666667" height="187" /></mxCell><mxCell id="storytext-S05-0" value="&lt;span style=&quot;font-size:14px;color:#AC6046;font-weight:400&quot;&gt;S05&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="683" width="336.6666666666667" height="23" /></mxCell><mxCell id="storytext-S05-1" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;恢复通知失败&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=20;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="713" width="336.6666666666667" height="31" /></mxCell><mxCell id="storytext-S05-2" value="&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;邮件未收到时可重新发送，并清楚说明报名&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;状态，避免重复支付。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="751" width="336.6666666666667" height="50" /></mxCell><mxCell id="storytext-S05-3" value="&lt;span style=&quot;font-size:14px;color:#6D6A63;font-weight:400&quot;&gt;来源：原创改进假说 H01&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="808" width="336.6666666666667" height="23" /></mxCell><mxCell id="story-S06" value="" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="666.6666666666667" y="868" width="368.6666666666667" height="187" /></mxCell><mxCell id="storytext-S06-0" value="&lt;span style=&quot;font-size:14px;color:#AC6046;font-weight:400&quot;&gt;S06&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="884" width="336.6666666666667" height="23" /></mxCell><mxCell id="storytext-S06-1" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;查找退改规则&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=20;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="914" width="336.6666666666667" height="31" /></mxCell><mxCell id="storytext-S06-2" value="&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;在确认付款前提供取消规则&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#30302D;font-weight:400&quot;&gt;与支持联系方式。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="952" width="336.6666666666667" height="50" /></mxCell><mxCell id="storytext-S06-3" value="&lt;span style=&quot;font-size:14px;color:#6D6A63;font-weight:400&quot;&gt;来源：原创改进假说 H02&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="1009" width="336.6666666666667" height="23" /></mxCell><mxCell id="_v48" value="&lt;span style=&quot;font-size:16px;color:#6D6A63;font-weight:400&quot;&gt;— 未安排&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=16;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1067.3333333333335" y="685" width="336.6666666666667" height="26" /></mxCell><mxCell id="_v49" value="&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;每个故事只安排一次；切片目标需由团队确认。此图不推断日期、工期或优先级分数。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1103" width="1372" height="25" /></mxCell><mxCell id="_v50" value="&lt;span style=&quot;font-size:14px;color:#AC6046;font-weight:400&quot;&gt;EXPERIENCE / RELEASE SLICES&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="34" width="1372" height="23" /></mxCell><mxCell id="_v51" value="&lt;span style=&quot;font-size:36px;color:#30302D;font-weight:600&quot;&gt;从报名到首次学习，每次交付都能走通&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=36;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="78" width="1372" height="53" /></mxCell><mxCell id="_v52" value="&lt;span style=&quot;font-size:18px;color:#6D6A63;font-weight:400&quot;&gt;在线课程 · 用户故事地图 · 原创模拟方案&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="139" width="1372" height="29" /></mxCell><mxCell id="_v53" value="&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;模拟方案 · 顺序来自示例输入，不代表真实产品承诺；交付切片不是时间比例。&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x=