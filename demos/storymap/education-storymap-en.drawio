style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="1005" width="336.6666666666667" height="50" /></mxCell><mxCell id="storytext-S06-3" value="&lt;span style=&quot;font-size:14px;color:#6D6A63;font-weight:400&quot;&gt;Source: Proposed improvement H02&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="682.6666666666667" y="1062" width="336.6666666666667" height="23" /></mxCell><mxCell id="_v48" value="&lt;span style=&quot;font-size:16px;color:#6D6A63;font-weight:400&quot;&gt;— Not scheduled&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=16;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1067.3333333333335" y="715" width="336.6666666666667" height="26" /></mxCell><mxCell id="_v49" value="&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Each story is assigned once. Confirm slice outcomes with the team. Dates, durations and priority scores are not inferred.&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1156" width="1372" height="25" /></mxCell><mxCell id="_v50" value="&lt;span style=&quot;font-size:14px;color:#AC6046;font-weight:400&quot;&gt;EXPERIENCE / RELEASE SLICES&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=Heiti TC;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="34" width="1372" height="23" /></mxCell><mxCell id="_v51" value="&lt;span style=&quot;font-size:36px;color:#30302D;font-weight:600&quot;&gt;A complete first learning experience, one release at a time&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#30302D;fontFamily=Heiti TC;fontSize=36;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="78" width="1372" height="53" /></mxCell><mxCell id="_v52" value="&lt;span style=&quot;font-size:18px;color:#6D6A63;font-weight:400&quot;&gt;Online education · User story map · Original simulated proposal&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=18;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="139" width="1372" height="29" /></mxCell><mxCell id="_v53" value="&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Simulated proposal · Input order is not a product commitment. Release slices are not calendar intervals.&lt;/span&gt;" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6D6A63;fontFamily=Heiti TC;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="1227" width="1372" height="25" /></mxCell><mxCell id="_edge_0" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D8D3C8;strokeWidth=1;fontColor=#D8D3C8;fontSize=15;labelBackgroundColor=#F1EFEB;endArrow=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="64" y="400" /><mxPoint as="targetPoint" x="1436" y="400" /></mxGeometry></mxCell><mxCell id="_edge_1" valu