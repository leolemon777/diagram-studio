" /></mxCell><mxCell id="step-match" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;04 · 匹配&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-match] 服务入口&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;展示符合条件的服务选项与限制&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;结果：选择一个可行选项&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="892" y="430" width="250" height="158" /></mxCell><mxCell id="step-confirm" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;05 · 确认&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-confirm] 照护者&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;确认时间、联系人和隐私提示&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;结果：提交预约请求&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1168" y="430" width="250" height="158" /></mxCell><mxCell id="step-submit" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;06 · 确认&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-submit] 服务入口&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;提交预约并显示处理状态&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;结果：等待服务方确认&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1444" y="430" width="250" height="158" /></mxCell><mxCell id="step-followup" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;07 · 跟进&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-followup] 服务入口&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;提供确认编号、变更入口和&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;人工联系方式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;结果：照护者知道下一步&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1720" y="430" width="250" height="158" /></mxCell><mxCell id="_v18" value="分支与异常 / Branches &amp;amp; exceptions" style="shape=text;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#AC6046;fontFamily=PingFang SC;fontSize=16;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="665" width="300" height="50" /></mxCell><mxCell id="branch-complete" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;[branch-complete] 分支 /&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;Branch&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;资料已完整 · 条件：必要字段都有值&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="693" width="310" height="112" /></mxCell><mxCell id="branch-assisted" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;[branch-assisted] 分支 /&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;Branch · 拟议&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;需要人工帮助 · 条件：照&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;护者无法独立完成&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="394" y="693" width="310" height="130" /></mxCell><mxCell id="exception-no-slot" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;[exception-no-slot] 异常 /&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;Exception · 拟议&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;没有可用时段 · 条件：当前服务选项全&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;部冲突 · 恢复：重新选择时间或转人工&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex=