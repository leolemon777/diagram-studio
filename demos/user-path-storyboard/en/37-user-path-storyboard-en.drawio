-size:20px;color:#30302D;font-weight:600&quot;&gt;03 · Triage ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;Proposed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-review] Caregiver&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Review the summary and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;add missing information&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Result: The request is&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;complete or needs human&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;help&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEFDF9;strokeColor=#D8D3C8;fontColor=#30302D;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="616" y="430" width="250" height="198" /></mxCell><mxCell id="step-match" value="&lt;span style=&quot;font-size:20px;color:#30302D;font-weight:600&quot;&gt;04 · Match&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;[step-match] Service entry&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Show eligible services and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;their constraints&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;Result: Choose one&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6D6A63;font-weight:400&quot;&gt;workable option&lt;/span&gt;" style="shape=rectangle;rounded=1;arcSize=1